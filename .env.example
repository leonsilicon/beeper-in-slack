# Copy to .env and fill in. Keep it private (chmod 600 .env): these tokens can read and send your messages.

# Beeper Desktop API token. `npm run beeper-token` fills this in after you approve it in Beeper.
BEEPER_ACCESS_TOKEN=
BEEPER_BASE_URL=http://127.0.0.1:23373

# From the Slack app created with slack-app-manifest.json: the bot token (xoxb-...) and an
# app-level token with connections:write (xapp-...).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Your Slack member ID, such as U0123456789.
SLACK_OWNER_USER_ID=

# Send what you write in Slack to your contacts. Leave off until you've watched it work.
SEND_ENABLED=false

# Also mirror muted and low-priority chats.
MIRROR_MUTED=false

# Comma-separated Beeper chat IDs, and networks by name or account prefix, to leave out entirely.
EXCLUDED_CHAT_IDS=
EXCLUDED_NETWORKS=

# Optional: an AI agent's bot member ID, which then receives digests of new messages.
AGENT_SLACK_USER_ID=

# Optional: your Slack web session (xoxc- token and d cookie), used only to file channels in a sidebar section.
SLACK_SESSION_TOKEN=
SLACK_SESSION_COOKIE=
SLACK_SIDEBAR_SECTION=Beeper
