{
  "name": "beeper-in-slack",
  "version": "0.1.0",
  "private": true,
  "description": "Every Beeper chat in its own private Slack channel, with replies sent back through Beeper.",
  "license": "MIT",
  "author": "Leon Si",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonsilicon/beeper-in-slack.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/**"
    ],
    "catalog": {
      "@slack/socket-mode": "3.1.1",
      "@slack/web-api": "8.3.0",
      "ws": "8.22.1",
      "@types/node": "24.19.2",
      "@types/ws": "8.18.2",
      "typescript": "7.0.2",
      "vite-plus": "1.5.0",
      "eslint-plugin-flatcap": "0.1.0"
    }
  },
  "type": "module",
  "scripts": {},
  "devDependencies": {
    "@-apps/beeper-in-slack": "workspace:*",
    "@types/node": "catalog:",
    "eslint-plugin-flatcap": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4"
}
